# ─── Google OAuth2 ────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/callback

# ─── Gmail Fetch ──────────────────────────────────────────────────────────────
# Max emails to pull per /ingest call (Gmail API maxResults cap is 500)
GMAIL_FETCH_LIMIT=200

# ─── Server & Network Security ───────────────────────────────────────────────
PORT=4000
CLIENT_URL=http://localhost:3000
SESSION_SECRET=your-random-32-byte-session-secret-here
TOKEN_ENCRYPTION_SECRET=your-random-32-byte-encryption-secret-here

# ─── Auth Mode ─────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY. Remove or set to false before any deployment.
# When true, requests without a session token fall through to the email in the request body.
# When false (or unset), any tokenless request gets a 401. This is the production-safe default.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALLOW_UNAUTHENTICATED_DEV=true

# ─── Python Agent Service (Phase 5) ───────────────────────────────────────────
AGENT_SERVICE_URL=http://localhost:8000
