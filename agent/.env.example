# ─── Free LLM: Google Gemini ──────────────────────────────────────────────────
# 100% Free tier (no credit card needed).
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Optional: OpenAI ─────────────────────────────────────────────────────────
# Fallback if preferred (paid):
OPENAI_API_KEY=

# ─── Paths ────────────────────────────────────────────────────────────────────
# Path to the shared SQLite DB written by the Node/Express server
SQLITE_DB_PATH=../server/data/gemai.db

# Where Chroma persists its on-disk index
CHROMA_DB_PATH=./chroma_db

# Chroma collection name — must match across all phases
CHROMA_COLLECTION=gemai_emails

# ─── Service ──────────────────────────────────────────────────────────────────
PORT=8000

# ─── Tracing & Observability (LangSmith) ──────────────────────────────────────
# Optional: Set to true and provide API key to trace LangGraph executions in LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=gemai-copilot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
